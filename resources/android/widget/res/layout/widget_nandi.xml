<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wn_go">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="4dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageView android:id="@+id/w_nandi"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:adjustViewBounds="true" android:scaleType="fitCenter"
            android:src="@drawable/nandi_surprised" android:contentDescription="Nandi" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3"
            android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FRI · 16 OCT" android:textColor="#B3FFE3A0" android:textSize="9.5sp"
                android:textStyle="bold" android:letterSpacing="0.16" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/w_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="21" android:textColor="#FFFFC46B" android:textSize="32sp"
                    android:fontFamily="sans-serif-black" android:includeFontPadding="false" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔥" android:textSize="13sp" android:includeFontPadding="false" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DAY STREAK" android:textColor="#CCF1E6CC" android:textSize="8.5sp"
                        android:textStyle="bold" android:letterSpacing="0.14" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/w_msg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:background="@drawable/wn_bubble"
                android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                android:text="C'mon, 10 minutes!" android:textColor="#FFF4F7FB" android:textSize="11.5sp"
                android:maxLines="2" android:ellipsize="end" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:orientation="horizontal">
                <TextView android:id="@+id/w_d0" android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginEnd="3dp" android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
                <TextView android:id="@+id/w_d1" android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginEnd="3dp" android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
                <TextView android:id="@+id/w_d2" android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginEnd="3dp" android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
                <TextView android:id="@+id/w_d3" android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginEnd="3dp" android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
                <TextView android:id="@+id/w_d4" android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginEnd="3dp" android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
                <TextView android:id="@+id/w_d5" android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_marginEnd="3dp" android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
                <TextView android:id="@+id/w_d6" android:layout_width="16dp" android:layout_height="16dp"
                     android:gravity="center" android:text="M"
                    android:textSize="8sp" android:textStyle="bold" android:textColor="#99FFFFFF"
                    android:background="@drawable/wn_dot_off" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
